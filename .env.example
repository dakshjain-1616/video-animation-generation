# Copy this file to .env (or edit .env directly) and fill in your key.
# Values here are used only when the same variable is not already exported.

# Required: all writing and code generation. Fixture mode is gone; `run` needs this.
OPENROUTER_API_KEY=

# Optional: preferred style theme/pack. CLI --theme/--pack wins.
# editorial-ink | clinical-slate | sunset-paper | forest-ink | mono-graphite
# VGA_PACK=editorial-ink

# Optional: any OpenRouter model id. Default is anthropic/claude-sonnet-5.5.
# VGA_MODEL=anthropic/claude-sonnet-5.5

# Optional per-stage routing: pay for a stronger model only where quality is
# decided (scene code and the vision review).
# VGA_PLAN_MODEL=anthropic/claude-sonnet-5.5
# VGA_CODEGEN_MODEL=anthropic/claude-sonnet-5.5
# VGA_REVIEW_MODEL=anthropic/claude-sonnet-5.5

# Optional repair budget for difficult videos (1-6, default 4).
# VGA_CODEGEN_ATTEMPTS=4

# Optional scene-code output budget. 8-10 scenes can exceed the 16k default.
# VGA_CODEGEN_MAX_TOKENS=32000

# Optional: voice-over (`run --voice`). ElevenLabs text-to-speech.
# ELEVENLABS_API_KEY=
# VGA_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional: local background-music library for `run --music`.
# Drop licensed tracks here; `<pack>.mp3` is preferred, otherwise the first file.
# VGA_MUSIC_DIR=data/music

# Web visual research runs by default when this key exists. Disable with
# --no-web-research. --fetch-media also downloads images and optional stock clips.
# TAVILY_API_KEY=
# PEXELS_API_KEY=
